#!name=可莉插件中心 · Surge 安装按钮
#!desc=用 Safari 打开 https://hub.kelee.one/?surge=2，点击原网页“安装”按钮，通过 Script Hub 官方 Beta 转换链接直接导入 Surge。
#!author=Feng-Feng1；转换引擎：Script-Hub-Org（@小白脸 @xream @keywos @ckyb）
#!category=工具
#!date=2026-10-10
#!version=2.0.0

# 开启脚本、MITM，并安装和信任 MITM 证书。
# 若已有 Script Hub 模块，将本模块放在前面以使用官方 Beta 引擎。
# 官方项目：https://github.com/Script-Hub-Org/Script-Hub
# 首次仍跳 Loon 时刷新插件中心，再重新打开页面。

[General]
force-http-engine-hosts = %APPEND% script.hub, *.script.hub

[Script]
Kelee: 安装按钮跳转 = type=http-response, pattern=^https:\/\/hub\.kelee\.one\/(?:index\.html)?(?:\?.*)?$, requires-body=true, max-size=1048576, script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/main/Kelee-Link-Converter.js?v=2.0.0, timeout=5
Kelee: Script Hub 插件转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|shadowrocket-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.beta.js, timeout=300
Kelee: Script Hub 规则转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/rule-parser.beta.js, timeout=300
Kelee: Script Hub 脚本转换 = type=http-request, pattern=^https?:\/\/script\.hub\/convert\/, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-converter.beta.js, timeout=300

[MITM]
hostname = %APPEND% hub.kelee.one, script.hub, *.script.hub
