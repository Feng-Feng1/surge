#!name=可莉链接转换 · Surge
#!desc=启用后用 Safari 打开 http://kelee.surge，粘贴公开明文 .plugin 或 loon://import 链接，生成 Surge 模块安装地址。已集成 Script Hub Beta 转换路由。加密 .lpx 不支持。
#!author=Feng-Feng1；转换引擎：Script-Hub-Org（@小白脸 @xream @keywos @ckyb）
#!category=工具
#!date=2026-10-10
#!version=1.0.0

# 本模块和原创页面：MIT，见 Licenses/Kelee-Link-Converter-MIT.txt。
# 转换脚本从 Script-Hub 官方仓库加载，依其 GPL-3.0 许可使用。
# 官方项目：https://github.com/Script-Hub-Org/Script-Hub
# 安装时请启用 Surge「脚本」和「MITM」，并安装、信任 MITM 证书。
# 与已有 Script Hub 模块同时启用时，请将本模块排在前面以使用 Beta 引擎。

[General]
force-http-engine-hosts = %APPEND% kelee.surge, script.hub, *.script.hub

[Script]
Kelee Converter: 页面 = type=http-request, pattern=^http:\/\/kelee\.surge(?:\/|\?|$), script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/main/Kelee-Link-Converter.js, timeout=5
Kelee Converter: 插件转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|shadowrocket-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.beta.js, timeout=300
Kelee Converter: 规则转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/rule-parser.beta.js, timeout=300
Kelee Converter: 脚本转换 = type=http-request, pattern=^https?:\/\/script\.hub\/convert\/, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-converter.beta.js, timeout=300

[MITM]
hostname = %APPEND% script.hub, *.script.hub
