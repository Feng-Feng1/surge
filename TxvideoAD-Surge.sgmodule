#!name=腾讯视频净化
#!desc=过滤开屏、播放和个人中心广告，精简底部标签栏
#!author=TG@ZenMoFiShi
#!system=ios

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
TxVideo-Request = type=http-request,pattern=^https?://i\.video\.qq\.com/(?:\?.*)?$,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/main/Txvideoad-Surge.txt,requires-body=true,binary-body-mode=true
TxVideo-Response = type=http-response,pattern=^https?://i\.video\.qq\.com/(?:\?.*)?$,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/main/Txvideoad-Surge.txt,requires-body=true,binary-body-mode=true
TxVideo-JCE = type=http-response,pattern=^https?://iacc\.qq\.com/(?:\?.*)?$,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/main/Txvideoad-Surge.txt,requires-body=true,binary-body-mode=true
TxVideo-Config = type=http-response,pattern=^https?://config\.ab\.qq\.com/tab/GetTabRemoteConfig(?:\?.*)?$,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/main/Txvideoad-Surge.txt,requires-body=true,binary-body-mode=true
TxVideo-Delivery = type=http-response,pattern=^https://rdelivery\.qq\.com/v1/sdkconfig/get(?:\?.*)?$,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/main/Txvideoad-Surge.txt,requires-body=true

[MITM]
hostname = %APPEND% i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
