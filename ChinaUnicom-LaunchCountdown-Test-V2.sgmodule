#!name=中国联通开屏倒计时 Test V2
#!desc=V2 修复 V1 响应脚本未执行：对实抓的 iphone_c@12.1400 配置立即返回完整原结构，仅将 adMaxTime=5、startMaxTime=3 改为 0；其他版本继续动态响应净化。
#!category=广告拦截测试
#!author=Night & ChatGPT
#!date=2026-09-04
#!version=2.0.0-test
#!system=ios


[Map Local]

# 当前联通接口虽已返回“不展示开屏广告”，但仍有网络往返。
# 本地返回相同业务结果，避免启动页等待该请求完成。
^https?:\/\/m\.client\.10010\.com\/mobileService\/customer\/accountListData\.htm(?:\?.*)?$ data-type=text data="{\"respDesc\":\"黑名单用户不展示开屏广告\",\"respCode\":\"9999\"}" status-code=200 header="Content-Type:application/json"

# 兼容旧版联通开屏接口；都返回“请求成功但无广告”，不使用网络 REJECT。
^https?:\/\/m\.client\.10010\.com\/mobileService\/(?:activity|customer)\/(?:get_client_adv|get_startadv)(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/m\.client\.10010\.com\/uniAdmsInterface\/getWelcomeAd(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"


[Script]

# 请求阶段：当前 12.1400 版本直接得到完整的零倒计时配置，避开服务器响应被 CANCEL。
中国联通-开屏配置立即返回 = type=http-request,pattern=^https?:\/\/m\.client\.10010\.com\/mobileService\/customer\/getclientconfig\.htm(?:\?|$),script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/refs/heads/main/ChinaUnicom-LaunchCountdown-Test-V2.txt,timeout=10,debug=true

# 响应阶段：未来或其他版本仍使用服务器实时配置，只改两个已验证字段。
中国联通-开屏配置响应兜底 = type=http-response,pattern=^https?:\/\/m\.client\.10010\.com\/mobileService\/customer\/getclientconfig\.htm(?:\?|$),requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/refs/heads/main/ChinaUnicom-LaunchCountdown-Test-V2.txt,timeout=30,debug=true

# 使用教程：
# 1. 将本模块和 ChinaUnicom-LaunchCountdown-Test-V2.txt 一起上传到 GitHub 仓库根目录。
# 2. Surge 只安装本 .sgmodule；TXT 不需要单独安装。
# 3. 更新模块后彻底划掉中国联通，先启动一次并停留到首页 10 秒，让配置落盘。
# 4. 再划掉 App 并冷启动第二次，观察是否不再等待倒计时。


[MITM]

hostname = %APPEND% m.client.10010.com
