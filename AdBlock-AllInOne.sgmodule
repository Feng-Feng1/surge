#!name=AdBlock Hybrid V3
#!desc=Surge 混合去广告：动态广告规则集 + 精确 URL 拦截 + Map Local + Body Rewrite + 闲鱼响应净化；保留酷安/微信小程序兼容保护，避免用全域断网换广告消失。
#!category=广告拦截
#!author=Night & ChatGPT
#!version=3.0-hybrid
#!date=2026-09-02
#!system=ios
#!homepage=https://github.com/
#
# ============================================================
# 设计原则
# ============================================================
# 1. 第三方广告 SDK：交给 AWAvenue Only.Ads 动态 RULE-SET。
# 2. 已知会重试/会卡启动的 SDK：先 DIRECT，再对“真正取广告路径”精确处理。
# 3. APP 第一方广告：用 URL Rewrite / Map Local / Body Rewrite。
# 4. 微信共享 CDN 不做全域封锁，只处理已确认的广告路径。
# 5. 不屏蔽统计/崩溃/推送只为了让 REJECT 数量看起来更多。
#
# 要求：
# - Surge iOS 5.14+（闲鱼 JQ Body Rewrite）
# - 已安装并信任 Surge MITM CA
# - Rewrite / MITM 功能开启
#
# 上游动态广告域名：
# https://github.com/TG-Twilight/AWAvenue-Ads-Rule
# 闲鱼首页/搜索净化脚本参考：
# https://github.com/androidcn/userscripts
#
# ============================================================


[Rule]

# ============================================================
# A. 兼容保护：必须位于动态广告规则集之前
# ============================================================

# ---------- 酷安正常业务 ----------
DOMAIN,api.coolapk.com,DIRECT
DOMAIN,image.coolapk.com,DIRECT
DOMAIN,avatar.coolapk.com,DIRECT

# ---------- 字节 TNC / SDK 网络配置 ----------
DOMAIN,tnc0-bjlgy.zijieapi.com,DIRECT
DOMAIN,tnc3-alisc1.zijieapi.com,DIRECT
DOMAIN,tnc3-alisc2.zijieapi.com,DIRECT
DOMAIN,tnc3-bjlgy.zijieapi.com,DIRECT
DOMAIN,tnc3-aliec1.zijieapi.com,DIRECT
DOMAIN,tnc3-aliec2.zijieapi.com,DIRECT

DOMAIN,tnc3-aliec1.toutiaoapi.com,DIRECT
DOMAIN,tnc3-aliec2.toutiaoapi.com,DIRECT
DOMAIN,tnc3-alisc1.toutiaoapi.com,DIRECT
DOMAIN,tnc3-bjlgy.toutiaoapi.com,DIRECT

DOMAIN,tnc3-aliec2.snssdk.com,DIRECT
DOMAIN,tnc3-alisc1.snssdk.com,DIRECT
DOMAIN,tnc3-bjlgy.snssdk.com,DIRECT

DOMAIN,tnc3-aliec2.bytedance.com,DIRECT
DOMAIN,tnc3-alisc1.bytedance.com,DIRECT
DOMAIN,tnc3-bjlgy.bytedance.com,DIRECT

# ---------- 穿山甲 / GroMore 主 API ----------
# 不整域 REJECT：酷安实测会出现启动阶段重试风暴。
# 真正的 get_ads / mediation exchange 在 [URL Rewrite] 精确拦。
DOMAIN,api-access.pangolin-sdk-toutiao.com,DIRECT
DOMAIN,api-access.pangolin-sdk-toutiao-b.com,DIRECT
DOMAIN,api-access.pangolin-sdk-toutiao1.com,DIRECT
DOMAIN,api-access.pangolin-sdk-toutiao2.com,DIRECT
DOMAIN,api-access.pangolin-sdk-toutiao3.com,DIRECT
DOMAIN,api-access.pangolin-sdk-toutiao4.com,DIRECT
DOMAIN,api-access.pangolin-sdk-toutiao5.com,DIRECT
DOMAIN,gromore.pangolin-sdk-toutiao.com,DIRECT
DOMAIN,log-api.pangolin-sdk-toutiao.com,DIRECT
DOMAIN,log-api.pangolin-sdk-toutiao-b.com,DIRECT

# ---------- 腾讯优量汇控制/SDK ----------
# 放行 SDK 控制面，广告素材域仍由下方动态规则集处理。
DOMAIN,sdk.e.qq.com,DIRECT
DOMAIN,sdkreport.e.qq.com,DIRECT
DOMAIN,tangram.e.qq.com,DIRECT
DOMAIN,masdkv6.3g.qq.com,DIRECT

# GDT 主接口在部分 APP 中失败后会高频重试。
# 这里放行 API，依靠广告素材域与精确路径减少广告。
DOMAIN,mi.gdt.qq.com,DIRECT
DOMAIN,v2mi.gdt.qq.com,DIRECT
DOMAIN,v3.gdt.qq.com,DIRECT
DOMAIN,win.gdt.qq.com,DIRECT

# ---------- 酷安抓包中确认的基础服务 ----------
DOMAIN,et.tanx.com,DIRECT
DOMAIN,sdk-config.tanx.com,DIRECT
DOMAIN,baichuan-sdk.alicdn.com,DIRECT
DOMAIN,mssdk.volces.com,DIRECT
DOMAIN,idfa2.shuzilm.cn,DIRECT
DOMAIN,tdid.m.qq.com,DIRECT
DOMAIN,access1.tpns.tencent.com,DIRECT
DOMAIN,tpns.qq.com,DIRECT

# 友盟基础配置/日志不作为核心广告拦截对象
DOMAIN,cnlogs.umeng.com,DIRECT
DOMAIN,cnlogs.umengcloud.com,DIRECT
DOMAIN,resolve.umeng.com,DIRECT
DOMAIN,utoken.umeng.com,DIRECT
DOMAIN,ucc.umeng.com,DIRECT

# ---------- 微信小程序共享基础资源 ----------
# AWAvenue 会命中其中部分域名，但它们也承载正常图片/视频/界面资源。
# 全域 REJECT 会出现“小程序图片没了/视频坏了/功能异常”。
# 已确认广告资源改由 [URL Rewrite] 精确处理。
DOMAIN,wxa.wxs.qq.com,DIRECT
DOMAIN,wximg.wxs.qq.com,DIRECT
DOMAIN,wxsmw.wxs.qq.com,DIRECT
DOMAIN,video.dispatch.tc.qq.com,DIRECT
DOMAIN,vlive.qqvideo.tc.qq.com,DIRECT

# ---------- 投屏核心服务 ----------
DOMAIN,conf.hpplay.cn,DIRECT
DOMAIN,gslb.hpplay.cn,DIRECT
DOMAIN,imdns.hpplay.cn,DIRECT
DOMAIN,vipauth.hpplay.cn,DIRECT
DOMAIN,vipgslb.hpplay.cn,DIRECT

# ---------- 京东/淘宝容易误伤的业务基础 ----------
DOMAIN,mapi.m.jd.com,DIRECT
DOMAIN,hybrid.miniapp.taobao.com,DIRECT


# ============================================================
# B. 广告 SDK 动态底座
# ============================================================
#
# 只引用 AWAvenue 1.7.6 拆分后的 Only.Ads：
# 不使用其 Privacy / Unwelcome 分类。
#
# 不加 pre-matching。
# 原因：pre-matching 会脱离普通从上到下优先级，
# 可能绕过上面的 DIRECT 兼容保护。
#
RULE-SET,https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Surge-RULE-SET-Only.Ads.list,REJECT,extended-matching,update-interval=86400


# ============================================================
# C. 少量静态兜底
# ============================================================
# 当远程规则集第一次下载失败时，仍保留最常见广告联盟的基础覆盖。

DOMAIN-SUFFIX,doubleclick.net,REJECT,extended-matching
DOMAIN-SUFFIX,googlesyndication.com,REJECT,extended-matching
DOMAIN-SUFFIX,googleadservices.com,REJECT,extended-matching
DOMAIN-SUFFIX,applovin.com,REJECT,extended-matching
DOMAIN-SUFFIX,applvn.com,REJECT,extended-matching
DOMAIN-SUFFIX,inmobi.com,REJECT,extended-matching
DOMAIN-SUFFIX,inmobicdn.net,REJECT,extended-matching
DOMAIN-SUFFIX,unityads.unity3d.com,REJECT,extended-matching
DOMAIN-SUFFIX,vungle.com,REJECT,extended-matching
DOMAIN-SUFFIX,adkwai.com,REJECT,extended-matching
DOMAIN-SUFFIX,pangle.io,REJECT,extended-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,extended-matching
DOMAIN-SUFFIX,gdtimg.com,REJECT,extended-matching
DOMAIN-SUFFIX,ugdtimg.com,REJECT,extended-matching


# ============================================================
# URL Rewrite：精确广告请求 / 广告资源
# ============================================================

[URL Rewrite]

# ------------------------------------------------------------
# 1. 酷安 / 穿山甲
# ------------------------------------------------------------
# 允许 SDK 初始化、settings、stats、log 正常完成，
# 只拒绝真正取广告/竞价交换路径。

^https?:\/\/api-access\.pangolin-sdk-toutiao(?:-b|[1-5])?\.com\/api\/ad\/union\/sdk\/get_ads\/ _ reject
^https?:\/\/gromore\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/mediation\/exchange\/ _ reject


# ------------------------------------------------------------
# 2. 微信小程序：小安科技实测
# ------------------------------------------------------------
# 自营广告配置
^https:\/\/ebike-client\.xiaoantech\.com\/client\/ad\/config\/getAdConfigForGuest(?:\?.*)?$ _ reject
^https:\/\/ebike-client-prod\.xiaoantech\.net\/client\/ad\/config\/getAdConfigV3(?:\?.*)?$ _ reject

# 广告视频：抓包中明确出现 ads_svp_video_
^https:\/\/wxsmw\.wxs\.qq\.com\/.*\/ads_svp_video_ _ reject

# 广告静态图：仅命中本次已确认目录，不封整个 wximg.wxs.qq.com
^https:\/\/wximg\.wxs\.qq\.com\/141\/20204\/snscosdownload\/SZ\/reserved\/ _ reject


# ------------------------------------------------------------
# 3. 闲鱼
# ------------------------------------------------------------

# 消息/推荐广告
^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend\/1\.0 _ reject

# 旧版欢迎页广告接口（保守限定到闲鱼 welcome）
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome _ reject


# ------------------------------------------------------------
# 4. 拼多多
# ------------------------------------------------------------

^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash _ reject
^https:\/\/images\.pinduoduo\.com\/mrk\/ _ reject
^https:\/\/images\.pinduoduo\.com\/marketing_api\/ _ reject
^https:\/\/video-dsp\.pddpic\.com\/market-dsp-video\/ _ reject
^https:\/\/t-dsp\.pinduoduo\.com\/dspcb\/i\/mrk_ _ reject


# ------------------------------------------------------------
# 5. 12306
# ------------------------------------------------------------

^https?:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$ _ reject


# ------------------------------------------------------------
# 6. CSDN
# ------------------------------------------------------------

^https?:\/\/app-gw\.csdn\.net\/silkroad-api\/api\/v\d+\/assemble\/list\/pub\/channel\/app_open_screen_ad _ reject
^https?:\/\/gw\.csdn\.net\/cms-app\/v\d+\/home_page\/open_advertisement _ reject


# ------------------------------------------------------------
# 7. 车来了
# ------------------------------------------------------------

^https?:\/\/pic1\.chelaile\.net\.cn\/adv\/ _ reject
^https?:\/\/(?:api|atrace)\.chelaile\.net\.cn\/adpub\/ _ reject
^https?:\/\/api\.chelaile\.net\.cn\/goocity\/advert\/ _ reject
^https?:\/\/web\.chelaile\.net\.cn\/api\/adpub\/ad _ reject


# ------------------------------------------------------------
# 8. Keep
# ------------------------------------------------------------

^https?:\/\/kad\.gotokeep\.com\/op-engine-webapp\/v\d+\/ad _ reject
^https?:\/\/api\.gotokeep\.com\/op-engine-webapp\/v\d+\/ad _ reject
^https?:\/\/api\.gotokeep\.com\/ads\/v\d+\/ads\/preload _ reject
^https?:\/\/api\.gotokeep\.com\/guide-webapp\/v\d+\/popup\/getPopUp _ reject
^https?:\/\/api\.gotokeep\.com\/kprime\/v\d+\/popups\/primeGuide _ reject


# ------------------------------------------------------------
# 9. 小米 / 米家
# ------------------------------------------------------------

^https:\/\/home\.mi\.com\/cgi-op\/api\/v1\/recommendation\/(?:banner|carousel\/banners|myTab|openingBanner) _ reject


# ------------------------------------------------------------
# 10. 小红书开屏
# ------------------------------------------------------------

^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config _ reject


# ------------------------------------------------------------
# 11. 网易云 / 网易系明确广告接口
# ------------------------------------------------------------

^https?:\/\/interface\d*\.music\.163\.com\/eapi\/ad\/ _ reject
^https?:\/\/sp\.kaola\.com\/api\/openad _ reject
^https?:\/\/support\.you\.163\.com\/xhr\/boot\/getBootMedia\.json _ reject


# ------------------------------------------------------------
# 12. 豆瓣 / 雪球 / 什么值得买等明确广告路径
# ------------------------------------------------------------

^https?:\/\/api\.douban\.com\/v\d+\/app_ads\/ _ reject
^https?:\/\/api\.xueqiu\.com\/ads\/display _ reject
^https?:\/\/api\.smzdm\.com\/v\d+\/util\/loading _ reject


# ============================================================
# Map Local：广告上报/场景接口直接本地返回
# ============================================================

[Map Local]

# 闲鱼广告启动上报：返回业务可接受的成功结构，避免网络重试
^https?:\/\/acs\.m\.(?:goofish|taobao)\.com\/gw\/mtop\.idle\.idleadv\.app\.launch\.report data-type=text data="{\"api\":\"mtop.idle.idleadv.app.launch.report\",\"data\":{\"attributeSuccess\":\"false\"},\"ret\":[\"SUCCESS::调用成功\"],\"v\":\"1.0\"}" status-code=200 header="Content-Type:application/json"

# 闲鱼广告场景恢复：明确告诉客户端不匹配广告场景
^https?:\/\/acs\.m\.(?:goofish|taobao)\.com\/gw\/mtop\.idle\.idleadv\.scene\.restore data-type=text data="{\"api\":\"mtop.idle.idleadv.scene.restore\",\"data\":{\"trackParams\":{\"stageMatch\":\"false\"}},\"ret\":[\"SUCCESS::调用成功\"],\"v\":\"1.0\"}" status-code=200 header="Content-Type:application/json"


# ============================================================
# Body Rewrite：第一方 API 返回体净化
# ============================================================

[Body Rewrite]

# ------------------------------------------------------------
# 闲鱼开屏：保留正常响应结构，只清空 adMap
# ------------------------------------------------------------
http-response-jq ^https?:\/\/acs\.m\.(?:goofish|taobao)\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.async\.ads 'if (.data? | type) == "object" then .data.adMap = {} else . end'

# ------------------------------------------------------------
# 闲鱼悬浮层 / 弹窗 / Banner：
# 保留正常功能策略与发布球，只移除明确广告类型
# ------------------------------------------------------------
http-response-jq ^https?:\/\/acs\.m\.(?:goofish|taobao)\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list 'if (.data.strategies? | type) == "array" then .data.strategies |= map(select((.type != "FLOAT_LAYER") and (.type != "POPUP") and (.type != "MODAL") and (.type != "BANNER"))) else . end'


# ============================================================
# Script：闲鱼信息流 / 搜索结果深度净化
# ============================================================
#
# 这里不用 Body Rewrite JQ 的原因：
# Surge iOS 的 Body Rewrite 对 response 最大只处理 1 MB，
# 闲鱼首页/搜索结果可能超过这个大小。
#
# 下面两个脚本只在两条精确 API 上运行，max-size 限为 3 MB，
# 不做全局 response-body 扫描，降低 Network Extension 内存压力。
#
# 上游脚本逻辑：
# - 首页只保留 data.bizType == item
# - 搜索只保留 item_type == goods
#

[Script]

闲鱼-首页信息流净化 = type=http-response,pattern=^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh\/,requires-body=true,max-size=3145728,script-path=https://raw.githubusercontent.com/androidcn/userscripts/main/goofish.js,timeout=30

闲鱼-搜索结果净化 = type=http-response,pattern=^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\/,requires-body=true,max-size=3145728,script-path=https://raw.githubusercontent.com/androidcn/userscripts/main/goofishSearch.js,timeout=30


# ============================================================
# MITM
# ============================================================
#
# 只列需要 URL/Body/Script 处理的主机。
# 酷安 api.coolapk.com 不 MITM。
# 不使用 hostname = *。
#

[MITM]

hostname = %APPEND% api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao-b.com, api-access.pangolin-sdk-toutiao1.com, api-access.pangolin-sdk-toutiao2.com, api-access.pangolin-sdk-toutiao3.com, api-access.pangolin-sdk-toutiao4.com, api-access.pangolin-sdk-toutiao5.com, gromore.pangolin-sdk-toutiao.com, ebike-client.xiaoantech.com, ebike-client-prod.xiaoantech.net, wxsmw.wxs.qq.com, wximg.wxs.qq.com, acs.m.goofish.com, acs.m.taobao.com, g-acs.m.goofish.com, api.pinduoduo.com, api.yangkeduo.com, images.pinduoduo.com, video-dsp.pddpic.com, t-dsp.pinduoduo.com, ad.12306.cn, app-gw.csdn.net, gw.csdn.net, pic1.chelaile.net.cn, api.chelaile.net.cn, atrace.chelaile.net.cn, web.chelaile.net.cn, kad.gotokeep.com, api.gotokeep.com, home.mi.com, www.xiaohongshu.com, interface.music.163.com, interface1.music.163.com, interface2.music.163.com, sp.kaola.com, support.you.163.com, api.douban.com, api.xueqiu.com, api.smzdm.com
