#!name=广告拦截 All-in-One
#!desc=Surge 综合去广告与提升APP启动速度。
#!author=Night & ChatGPT
#!date=2026-09-01
#!system=ios

[Rule]

# =========================================================
# 0. 兼容 / 快速启动
# =========================================================
# 这些服务在实际抓包中与 SDK 初始化、推送、配置有关。
# 不应为了“看起来拦得多”而一刀切。
# 必须位于后面的广告规则之前。

# ---- Tanx ----
DOMAIN,et.tanx.com,DIRECT
DOMAIN,sdk-config.tanx.com,DIRECT

# ---- 腾讯设备标识 / 推送 ----
DOMAIN,tdid.m.qq.com,DIRECT
DOMAIN,tpns.qq.com,DIRECT
DOMAIN,access1.tpns.tencent.com,DIRECT

# ---- Mob 短信验证 ----
DOMAIN,init.sms.mob.com,DIRECT
DOMAIN,sdkapi.sms.mob.com,DIRECT
DOMAIN,code.sms.mob.com,DIRECT

# ---- 极光验证码 ----
DOMAIN,smartop-sdkapi.jiguang.cn,DIRECT
DOMAIN,sdk.verification.jiguang.cn,DIRECT

# ---- 字节 TNC 配置 ----
AND,((DOMAIN-KEYWORD,tnc),(OR,((DOMAIN-SUFFIX,capcutapi.com),(DOMAIN-SUFFIX,zijieapi.com),(DOMAIN-SUFFIX,isnssdk.com),(DOMAIN-SUFFIX,toutiaoapi.com),(DOMAIN-SUFFIX,bytedance.com),(DOMAIN-SUFFIX,snssdk.com),(DOMAIN-SUFFIX,sgsnssdk.com)))),DIRECT


