[URL Rewrite]

# =========================================================
# 菜鸟 V4.1：广告链路精确补强
# =========================================================
#
# HAR 实测：
# - 腾讯 GDT 请求已被 V4 拦截
# - 剩余广告主要来自菜鸟第一方广告编排 + 穿山甲素材/曝光链路
#
# 这里只补明确广告路径，不把穿山甲 settings/stats 整域杀掉，
# 避免再次引发酷安一类 APP 的开屏重试风暴。
# =========================================================

# 字节广告曝光上报
^https:\/\/tr\.byteurl\.cn\/ad\/impression\/toutiao\/ _ reject

# 字节广告组件/可播放素材
^https:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/ _ reject


# =========================================================
# A. 酷安 / 穿山甲：避免开屏卡死
# =========================================================
# 主 API 保持 DIRECT，只杀真正取广告/竞价路径。
# 酷安 get_ads 不再硬 REJECT。
# HAR 中同一开屏阶段可连续出现二十余次 get_ads；网络错误会驱动 SDK 重试。
# 现在改由 [Map Local] 直接返回穿山甲“无填充”JSON，让 SDK 立即结束本次广告请求。

# 酷安 2026-09-02 HAR 实抓：
# get_ads 已被 V4.1 正常拒绝，但广告仍从 api-access 主机的 mediation/exchange 返回。
# 只补这个明确广告交换接口；不封整个穿山甲主机，避免恢复开屏重试/卡顿。
^https?:\/\/api-access\.pangolin-sdk-toutiao(?:-b|[1-5])?\.com\/api\/ad\/union\/mediation\/exchange\/ _ reject
^https?:\/\/gromore\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/mediation\/exchange\/ _ reject

# =========================================================
# B. 微信小程序 / 小安科技实测
# =========================================================
# 小安广告配置不再硬 REJECT；由 [Map Local] 返回“成功但无广告”，避免失败重试/读秒。
# 小安广告配置不再硬 REJECT；由 [Map Local] 返回“成功但无广告”，避免失败重试/读秒。
^https:\/\/wxsmw\.wxs\.qq\.com\/.*\/ads_svp_video_ _ reject
^https:\/\/wximg\.wxs\.qq\.com\/141\/20204\/snscosdownload\/SZ\/reserved\/ _ reject

# =========================================================
# C. 闲鱼明确广告请求
# =========================================================
^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend\/1\.0 _ reject
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome _ reject

# =========================================================
# D. 拼多多
# =========================================================
^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash _ reject
^https:\/\/images\.pinduoduo\.com\/mrk\/ _ reject
^https:\/\/images\.pinduoduo\.com\/marketing_api\/ _ reject
^https:\/\/video-dsp\.pddpic\.com\/market-dsp-video\/ _ reject
^https:\/\/t-dsp\.pinduoduo\.com\/dspcb\/i\/mrk_ _ reject

