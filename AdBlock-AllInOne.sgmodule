#!name=AdBlock Hybrid V4.1.8.3 Test
#!desc=Surge 强力混合去广告：基于 V4.1.8.2；新增腾讯视频 MVL Protobuf 二进制广告组件实验净化。该分支用于验证详情页顶部长广告与信息流广告，确认稳定后再并入正式基线。
#!category=广告拦截
#!author=Night & ChatGPT
#!date=2026-09-02
#!version=4.1.8.3-tencentvideo-mvl-test
#!system=ios


[Rule]


# =========================================================
# 0. 功能兼容 / APP 启动优化
# =========================================================

DOMAIN,et.tanx.com,DIRECT
DOMAIN,sdk-config.tanx.com,DIRECT

DOMAIN,tdid.m.qq.com,DIRECT
DOMAIN,tpns.qq.com,DIRECT
DOMAIN,access1.tpns.tencent.com,DIRECT

DOMAIN,init.sms.mob.com,DIRECT
DOMAIN,sdkapi.sms.mob.com,DIRECT
DOMAIN,code.sms.mob.com,DIRECT

DOMAIN,smartop-sdkapi.jiguang.cn,DIRECT
DOMAIN,sdk.verification.jiguang.cn,DIRECT

AND,((DOMAIN-KEYWORD,tnc),(OR,((DOMAIN-SUFFIX,capcutapi.com),(DOMAIN-SUFFIX,zijieapi.com),(DOMAIN-SUFFIX,isnssdk.com),(DOMAIN-SUFFIX,toutiaoapi.com),(DOMAIN-SUFFIX,bytedance.com),(DOMAIN-SUFFIX,snssdk.com),(DOMAIN-SUFFIX,sgsnssdk.com)))),DIRECT


# =========================================================
# 0.5 高优先级广告底座（关键修复）
# =========================================================
#
# V3 的核心错误：
# 把广告底座改成普通优先级 RULE-SET，又把多个广告 SDK 主机 DIRECT，
# 导致不少请求在真正广告规则生效前直接放行。
#
# 这里恢复 pre-matching：广告会在 DNS/TCP 建连阶段优先阻断。
# 但通过 NOT 例外剔除已知会导致酷安/投屏/京东等重试或功能异常的主机。
#
# 即使下面远程 RULE-SET 暂时下载失败，V2.2 原有的数百条静态规则仍然存在，
# 不会再出现 V3 那种“核心规则失效后广告几乎全回来”的情况。
# =========================================================

AND,((RULE-SET,https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Surge-RULE-SET-Only.Ads.list,extended-matching),(NOT,((OR,((DOMAIN,api-access.pangolin-sdk-toutiao.com),(DOMAIN,api-access.pangolin-sdk-toutiao-b.com),(DOMAIN,api-access.pangolin-sdk-toutiao1.com),(DOMAIN,api-access.pangolin-sdk-toutiao2.com),(DOMAIN,api-access.pangolin-sdk-toutiao3.com),(DOMAIN,api-access.pangolin-sdk-toutiao4.com),(DOMAIN,api-access.pangolin-sdk-toutiao5.com),(DOMAIN,gromore.pangolin-sdk-toutiao.com),(DOMAIN,log-api.pangolin-sdk-toutiao.com),(DOMAIN,log-api.pangolin-sdk-toutiao-b.com),(DOMAIN,sdk.e.qq.com),(DOMAIN,sdkreport.e.qq.com),(DOMAIN,tangram.e.qq.com),(DOMAIN,masdkv6.3g.qq.com),(DOMAIN-SUFFIX,gdt.qq.com),(DOMAIN,baichuan-sdk.alicdn.com),(DOMAIN,baichuan-sdk.taobao.com),(DOMAIN,mapi.m.jd.com),(DOMAIN,hybrid.miniapp.taobao.com),(DOMAIN,conf.hpplay.cn),(DOMAIN,gslb.hpplay.cn),(DOMAIN,imdns.hpplay.cn),(DOMAIN,vipauth.hpplay.cn),(DOMAIN,vipgslb.hpplay.cn),(DOMAIN,ad.12306.cn)))))),REJECT,pre-matching

# ---------------------------------------------------------
# 微信小程序强力模式
# ---------------------------------------------------------
# 这三条是你之前使用的大型规则能够高命中小程序广告的重要原因。
# 代价是：极少数小程序的正常图片/媒体资源也可能被影响。
# 现在目标是“尽可能去广告”，所以 V4 默认开启。
DOMAIN,wxa.wxs.qq.com,REJECT,extended-matching,pre-matching
DOMAIN,wximg.wxs.qq.com,REJECT,extended-matching,pre-matching
DOMAIN,wxsmw.wxs.qq.com,REJECT,extended-matching,pre-matching




