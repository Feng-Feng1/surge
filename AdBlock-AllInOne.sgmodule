# =========================================================
# Map Local：闲鱼广告控制接口本地应答
# =========================================================

[Map Local]


# =========================================================
# 小安科技微信小程序：广告配置 Fail-Fast / No-Ad
# =========================================================
#
# 2026-09-02 HAR 实抓结论：
#
# A. 旧规则的问题
# ---------------------------------------------------------
# ebike-client.xiaoantech.com
# /client/ad/config/getAdConfigForGuest
#
# 在不到 1 秒里被 URL Rewrite 硬 reject 约 79 次。
# 这说明“把广告接口断网”并没有让小程序认为没有广告，
# 反而触发了高频重试，容易形成空白广告页/读秒等待。
#
# B. 真正漏网的广告配置
# ---------------------------------------------------------
# ebike-client-j.xiaoantech.net
# /client/ad/config/getAdConfigV3
#
# HAR 中它正常返回约 10 KB JSON，里面有 16 个广告位，包括：
# - cover：封面
# - unLockSuc：车辆开锁成功后插屏
# - toPrecycling：开锁骑行前插屏
# - paid：骑行支付后插屏
# - homeBottom / recharge / userInfoBottom 等原生广告
# - 聚聚好玩的骑行结束页弹窗 / 订单页 Banner
#
# 所以仅屏蔽 wximg/wxsmw 广告素材，只能让“画面消失”；
# 小程序仍然拿到了“这里应该显示广告”的配置，自然还会创建
# 广告容器、弹窗和本地倒计时。
#
# C. 新策略
# ---------------------------------------------------------
# 对三个已实测环境主机统一返回服务端正常成功结构：
#
#   {"success":true,"code":"0","msg":"成功","data":[]}
#
# 也就是：
# “接口成功，但当前一个广告位都没有。”
#
# 这样比 REJECT 更接近真正的“无广告用户”状态：
# - 不生成 cover
# - 不生成微信插屏 adunit
# - 不生成原生广告位
# - 不触发第三方聚聚好玩弹窗
# - 客户端无需等待网络失败/重试
# =========================================================

^https:\/\/(?:ebike-client\.xiaoantech\.com|ebike-client-prod\.xiaoantech\.net|ebike-client-j\.xiaoantech\.net)\/client\/ad\/config\/(?:getAdConfigForGuest|getAdConfigV3)(?:\?.*)?$ data-type=text data="{\"success\":true,\"code\":\"0\",\"msg\":\"成功\",\"data\":[]}" status-code=200 header="Content-Type:application/json"

# 用车说明页还有一套独立的智能/插屏广告开关。
# HAR 实抓返回 shieldSmartAd=true，并下发两个微信 adunit。
# 这里返回同结构，但显式关闭广告并清空 adunit。
^https:\/\/ebike-client\.xiaoantech\.com\/client\/ad\/config\/getShieldSmartAdConfig(?:\?.*)?$ data-type=text data="{\"success\":true,\"code\":\"0\",\"msg\":\"成功\",\"data\":{\"shieldSmartAd\":false,\"shieldSmartAdUnitId\":\"\",\"shieldInterstitialAdUnitId\":\"\",\"shieldSmartAdUnitName\":\"\",\"shieldInterstitialAdUnitName\":\"\"}}" status-code=200 header="Content-Type:application/json"


# =========================================================
# 小安科技微信小程序：剩余运营弹窗 / 骑行卡促销
# =========================================================
#
# 2026-09-02 新 HAR 验证：
# - getAdConfigForGuest / getAdConfigV3 已经稳定命中 Map Local，
#   均在约 2 ms 内返回 data=[]，不再出现之前的高频重试。
# - getShieldSmartAdConfig 也已返回 shieldSmartAd=false。
#
# 但同一轮启动中仍有第一方运营弹窗：
# /client/helpConfig/getSpecialTipsByServiceIdV3
#
# 实际返回：
#   title = 骑行卡更新通知
#   descriptionTag / body = 购卡、优惠、限时活动
#   izOn = true
#   frequency = 1
#
# 这类内容不是微信广告 SDK，而是小安自己的运营弹窗。
# 直接返回“接口成功 + 无弹窗数据”，避免只遮素材却保留弹窗容器。
^https:\/\/(?:ebike-client\.xiaoantech\.com|ebike-client-prod\.xiaoantech\.net|ebike-client-j\.xiaoantech\.net)\/client\/helpConfig\/getSpecialTipsByServiceIdV3(?:\?.*)?$ data-type=text data="{\"success\":true,\"code\":\"0\",\"msg\":\"成功\",\"data\":[]}" status-code=200 header="Content-Type:application/json"

# 骑行卡促销配置同样属于运营推广。
# 保留原接口数据结构，只清空 ridingCards，降低前端类型不匹配风险。
^https:\/\/(?:ebike-client\.xiaoantech\.com|ebike-client-prod\.xiaoantech\.net|ebike-client-j\.xiaoantech\.net)\/client\/helpConfig\/getCardPromoteConfigByServiceId(?:\?.*)?$ data-type=text data="{\"success\":true,\"code\":\"0\",\"msg\":\"成功\",\"data\":{\"ridingCards\":[],\"izCusConfigCard\":false,\"izDefaultCardPromoteConfig\":false}}" status-code=200 header="Content-Type:application/json"



# =========================================================
# 酷安：广告 SDK Fail-Fast（减少开屏读秒）
# =========================================================
#
# 当前 HAR 明确看到：
# - api-access.pangolin-sdk-toutiao*.com /get_ads/ 被硬 reject 后高频重试
# - v2mi.gdt.qq.com/gdt_mview.fcg 被连续 reject，
#   Surge 已自动升级为 REJECT-DROP
#
# 这里不再制造“网络错误”，而是直接在本机返回广告 SDK 能理解的
# “请求成功但无广告填充”结果，让 SDK 尽快结束等待。
#
# 穿山甲 no-fill：
# status_code=20001 为广告无填充/填充受控类错误码。
# 结构取自公开维护的广告联盟净化脚本。
# =========================================================

^https?:\/\/api-access\.pangolin-sdk-toutiao(?:-b|[1-5])?\.com\/api\/ad\/union\/sdk\/get_ads\/(?:\?.*)?$ data-type=text data="{\"request_id\":\"00000000-0000-0000-0000-000000000000\",\"status_code\":20001,\"reason\":112,\"desc\":\"no ad fill\"}" status-code=200 header="Content-Type:application/json"

# 腾讯优量汇：
# ret=102006 表示没有合适广告/无填充，避免把网络失败当成可重试错误。
#
# V4.1.6 最新 HAR 已确认：
# - replyList 中的 Coolapk 第一方 Sponsor 卡已经被成功删除；
# - 但 mi.gdt.qq.com/gdt_mview.fcg 仍返回真实广告：
#   ret=0，并带 8KB 左右的加密 list 广告载荷；
# - 评论区看到的“爱聊”等卡片就是这层 GDT 原生广告继续插入。
#
# 因此同时处理 mi.gdt.qq.com 和 v2mi.gdt.qq.com，
# 都返回“无填充”，而不是硬 REJECT，避免再次引发酷安读秒。
^https?:\/\/(?:v2)?mi\.gdt\.qq\.com\/gdt_mview\.fcg(?:\?.*)?$ data-type=text data="{\"ret\":102006,\"msg\":\"\"}" status-code=200 header="Content-Type:application/json"


# =========================================================
# 哔哩哔哩：开屏广告（Bilibili 9.10.0 HAR 实抓）
# =========================================================
#
# HAR 明确出现：
# - /x/v2/splash/list
#   返回约 860 KB 广告池，包含 is_ad=true、SPLASH.mp4、广告落地页等。
# - /x/v2/splash/show
#   返回当前实际要展示的开屏广告。
#
# 不直接 REJECT 请求，避免 APP 把网络失败当作异常并等待/重试。
# 直接本地返回“成功但无广告”的合法 JSON：
# - list/show 为空
# - keep_ids 为空，促使客户端淘汰旧广告缓存
# - 保留 B 站自己的 brand/list，不动正常启动图。
# =========================================================

^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list(?:\?.*)?$ data-type=text data="{\"code\":0,\"message\":\"OK\",\"ttl\":1,\"data\":{\"max_time\":0,\"min_interval\":3600,\"pull_interval\":900,\"keep_ids\":[],\"list\":[],\"show\":[],\"splash_request_id\":\"\"}}" status-code=200 header="Content-Type:application/json"

^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/show(?:\?.*)?$ data-type=text data="{\"code\":0,\"message\":\"OK\",\"ttl\":1,\"data\":{\"show\":[],\"splash_request_id\":\"\"}}" status-code=200 header="Content-Type:application/json"


# =========================================================
# 菜鸟：第一方广告 API 本地空响应
# =========================================================
# 重点处理首页“大家都在逛”、广告流、飞行广告、底部商品推广。
# 比单纯封 CDN 更彻底：直接让广告容器拿不到广告数据。

^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?!.*_home) data-type=text data=" " status-code=200
^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.mshow\.cn data-type=text data=" " status-code=200
^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn data-type=text data=" " status-code=200
^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.app\.home\.v\d+\.bottom\.area data-type=text data=" " status-code=200

^https?:\/\/[a-zA-Z0-9_.-]+\.taobao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\. data-type=text data=" " status-code=200
^https?:\/\/[a-zA-Z0-9_.-]+\.taobao\.com\/gw\/mtop\.alimama\.abyss\.unionpage\.get data-type=text data=" " status-code=200
^https?:\/\/[a-zA-Z0-9_.-]+\.taobao\.com\/gw\/mtop\.cainiao\.adx\.flyad\.getad data-type=text data=" " status-code=200


^https?:\/\/acs\.m\.(?:goofish|taobao)\.com\/gw\/mtop\.idle\.idleadv\.app\.launch\.report data-type=text data="{\"api\":\"mtop.idle.idleadv.app.launch.report\",\"data\":{\"attributeSuccess\":\"false\"},\"ret\":[\"SUCCESS::调用成功\"],\"v\":\"1.0\"}" status-code=200 header="Content-Type:application/json"

^https?:\/\/acs\.m\.(?:goofish|taobao)\.com\/gw\/mtop\.idle\.idleadv\.scene\.restore data-type=text data="{\"api\":\"mtop.idle.idleadv.scene.restore\",\"data\":{\"trackParams\":{\"stageMatch\":\"false\"}},\"ret\":[\"SUCCESS::调用成功\"],\"v\":\"1.0\"}" status-code=200 header="Content-Type:application/json"


# =========================================================
# Body Rewrite：闲鱼第一方 JSON 广告净化
# =========================================================

[Body Rewrite]

# =========================================================
# 酷安：评论区 Sponsor 广告卡片
# =========================================================
#
# 2026-09-02 HAR 实抓：
# /v6/feed/replyList 返回的评论数组里直接混入了广告占位卡：
#   entityTemplate = feedDetailReplySponsorCard
#   title          = FEED_DETAIL_REPLY_SPONSOR_CARD
#   entityId       = sponsor-feedList-feedDetail / -2 / -3 ...
#
# 这不是第三方广告域名漏网，而是酷安自己的 API 把“广告容器”
# 直接夹在正常评论数据里。外部素材即使被拦，容器仍会显示成广告块。
#
# 因此这里不再碰广告 SDK，而是在 replyList JSON 返回后，
# 只删除这类 Sponsor 卡，正常评论内容保持不变。
# =========================================================

# V4.1.8：只按酷安专用模板精确删除。
# HAR 已确认广告卡模板就是 feedDetailReplySponsorCard。
# 不再对 entityId 做 startswith()，避免普通数字评论 ID 触发 JQ 类型错误。
http-response-jq ^https:\/\/api\.coolapk\.com\/v6\/feed\/replyList 'if (.data? | type) == "array" then .data |= map(select((.entityTemplate // "") != "feedDetailReplySponsorCard")) else . end'


# 开屏：清空 adMap
http-response-jq ^https?:\/\/acs\.m\.(?:goofish|taobao)\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.async\.ads 'if (.data? | type) == "object" then .data.adMap = {} else . end'

# 悬浮层 / 弹窗 / Banner
http-response-jq ^https?:\/\/acs\.m\.(?:goofish|taobao)\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list 'if (.data.strategies? | type) == "array" then .data.strategies |= map(select((.type != "FLOAT_LAYER") and (.type != "POPUP") and (.type != "MODAL") and (.type != "BANNER"))) else . end'

# 首页信息流：在 1 MB 内时完全自包含过滤
http-response-jq ^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh\/ 'if (.data.sections? | type) == "array" then .data.sections |= map(select(.data.bizType == "item")) | .data.feedsCount = (.data.sections | length) else . end'

# 搜索：在 1 MB 内时完全自包含过滤
http-response-jq ^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\/ 'if (.data.resultList? | type) == "array" then .data.resultList |= map(select(.data.item.main.clickParam.args.item_type == "goods")) else . end'


# =========================================================
# Script：闲鱼大响应兜底（超过 Body Rewrite iOS 1 MB 限制时）
# =========================================================

[Script]

# =========================================================
# 铁路12306：开屏广告无广告正常返回
# =========================================================
#
# V4.1.3 使用的 kelee.one 旧脚本地址已返回 404，
# 导致 ad.12306.cn 已被 DIRECT 放行但请求脚本没有执行，所以广告重新出现。
#
# V4.1.4 改用当前仍可访问的 ddgksf2013 原始 12306 脚本。
# 该脚本会直接针对 placementNo 返回本地“无广告/1秒跳过”响应，
# 不需要真正向广告服务器获取广告素材。
#
# 当前问题不是“广告没拦住”，而是拦得太早：
# ad.12306.cn 在 DNS/TCP 阶段直接失败后，客户端仍会等待失败/超时。
#
# 改成：
# ad.12306.cn -> DIRECT
# getAdList -> 请求脚本修改
#
# 让服务器正常完成一次“没有可展示广告”的请求，
# 目标是同时解决“广告消失”和“开屏空等”。
# =========================================================

铁路12306-开屏广告净化 = type=http-request,pattern=^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/12306.js,timeout=30


# =========================================================
# 菜鸟：第一方响应深度净化
# =========================================================
#
# 这些接口会把广告和正常首页数据混在同一响应里，
# 所以不能整域 REJECT，只删除广告模块。
#
# 上游脚本会处理：
# - homepage.merge / protocol.homepage
# - e2e.engine.page.fetch
# - adkeyword
# - nbnetflow 广告数据结构
# =========================================================

菜鸟-AMDC净化 = type=http-response,pattern=^http:\/\/amdc\.m\.taobao\.com,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/ifflagged/Romeo/main/Modules/JavaScript/ddgksf2013/CainiaoAds/ddgksf2013_amdc.js,timeout=60

菜鸟-首页Merge净化 = type=http-response,pattern=^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.homepage\.merge\.get\.cn,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/ifflagged/Romeo/main/Modules/JavaScript/ddgksf2013/CainiaoAds/ddgksf2013_cainiao_json.js,timeout=60

菜鸟-首页Protocol净化 = type=http-response,pattern=^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.protocol\.homepage\.get\.cn,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/ifflagged/Romeo/main/Modules/JavaScript/ddgksf2013/CainiaoAds/ddgksf2013_cainiao_json.js,timeout=60

菜鸟-E2E页面净化 = type=http-response,pattern=^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/ifflagged/Romeo/main/Modules/JavaScript/ddgksf2013/CainiaoAds/ddgksf2013_cainiao_json.js,timeout=60

菜鸟-广告关键词净化 = type=http-response,pattern=^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.adkeyword,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/ifflagged/Romeo/main/Modules/JavaScript/ddgksf2013/CainiaoAds/ddgksf2013_cainiao_json.js,timeout=60


闲鱼-首页信息流净化 = type=http-response,pattern=^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh\/,requires-body=true,max-size=3145728,script-path=https://raw.githubusercontent.com/androidcn/userscripts/main/goofish.js,timeout=30

闲鱼-搜索结果净化 = type=http-response,pattern=^https:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\/,requires-body=true,max-size=3145728,script-path=https://raw.githubusercontent.com/androidcn/userscripts/main/goofishSearch.js,timeout=30


# =========================================================
# 腾讯视频：MVL 详情页 Protobuf 广告组件实验净化
# =========================================================
#
# 2026-09-02 HAR 实抓：
# i.video.qq.com 的 getMVLPage 二进制响应中包含：
# - ad_block_4
# - feeds_ad_style
# - AdFeedInfo
# - AdFocusPoster
# - AdResponseInfo
# - AdOpenWxProgramAction
#
# 这些不是单独的 GDT 素材请求，而是腾讯视频第一方 MVL 页面响应
# 直接下发的广告组件。脚本使用 binary-body-mode=true，在原始字节中
# 做“等长度标识符替换”，不增删 Protobuf 字节，尽量避免破坏页面结构。
#
# 注意：这是实验分支。
# 若详情页空白、闪退、正常视频/选集异常，立即退回 V4.1.8.2。
# =========================================================

腾讯视频-MVL广告组件净化 = type=http-response,pattern=^https:\/\/i\.video\.qq\.com\/,requires-body=true,max-size=-1,binary-body-mode=true,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/refs/heads/main/TenVideo-MVL-AdFilter-Test.js,timeout=30


