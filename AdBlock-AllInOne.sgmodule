# =========================================================
# URL Rewrite：同域广告路径
# =========================================================
# HTTPS Rewrite 必须配合 MITM。
# 这里只处理相对明确的广告路径，不对 api.* 做泛匹配。

[URL Rewrite]

# 拼多多营销素材
^https:\/\/images\.pinduoduo\.com\/mrk\/ _ reject
^https:\/\/images\.pinduoduo\.com\/marketing_api\/ _ reject

# 百度网盘广告资源
^https:\/\/issuecdn\.baidupcs\.com\/issue\/netdisk\/guanggao\/ _ reject


# =========================================================
# MITM
# =========================================================
# 仅为上面的路径级 Rewrite 开 MITM。
# 不做 * 全域 MITM，避免证书固定、耗电、兼容性问题。

[MITM]
hostname = %APPEND% images.pinduoduo.com, issuecdn.baidupcs.com
