#!name=优酷播放广告净化 Test V2
#!desc=按 2026-09-04 两份 HAR 三层净化优酷播放广告：删除 UPS 的 ad/ykad、移除 HLS 中 ccode=0902 的异 VID 拼接广告，并对缓存残留的 ykVideoShowType=2 广告媒体返回 204。
#!category=广告拦截测试
#!author=Night & ChatGPT
#!date=2026-09-04
#!version=2.0.0-test
#!system=ios


[Map Local]

# V1 已成功删除响应广告对象，但 13:08 HAR 仍看到旧广告缓存继续请求：
# /youku/...mp4?...&ykVideoShowType=2
# 只对这个优酷广告播放标记返回 204，不封整个 cp31/vali CDN。
^http:\/\/[^\/]+\/youku\/[^?]+\.mp4\?(?:[^#]*&)?ykVideoShowType=2(?:&[^#]*)?$ data-type=text data="" status-code=204


[Script]

# 第一层：删除 UPS 响应内的 ad 与 ykad 广告对象。
优酷-播放广告响应净化 = type=http-response,pattern=^https:\/\/un-acs\.youku\.com\/gw\/mtop\.youku\.play\.ups\.appinfo\.get\/,requires-body=true,max-size=3145728,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/refs/heads/main/Youku-Video-AdFilter-Test.txt,timeout=30,debug=true

# 第二层：HLS 中正片与广告共用媒体 CDN，但广告块可由
# ccode=0902 + 非主 VID + DISCONTINUITY 三项联合识别并整块删除。
优酷-HLS拼接广告净化 = type=http-response,pattern=^https?:\/\/pl-ali\.youku\.com\/playlist\/m3u8(?:\?|$),requires-body=true,max-size=3145728,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/refs/heads/main/Youku-Video-AdFilter-Test.txt,timeout=30,debug=true


# 使用教程：
# 1. 将本文件内容复制到 GitHub 的 Youku-Video-AdFilter-Test.sgmodule。
# 2. 将 Youku-Video-AdFilter-Test.txt 脚本上传到 GitHub 仓库根目录，并覆盖旧 V1。
# 3. 两个 GitHub 文件名和 Raw 地址都保持不变；Surge 只安装 .sgmodule 的 Raw 地址。
# 4. 在 Surge 模块页面更新本模块，确认名称显示“优酷播放广告净化 Test V2”。
# 5. 保持总模块开启，本模块作为独立测试分支同时启用。
# 6. 在优酷“设置 -> 清除缓存”先清一次旧广告缓存，再彻底划掉优酷。
# 7. 冷启动优酷并播放刚才同一集视频。
# 8. 在 Surge 请求备注中确认至少出现：
#    Youku Test V2 removed playback ads
#    Youku Test V2 removed HLS ad blocks
# 9. 连续测试换集、拖动进度、切换清晰度；若黑屏或无法播放，立即关闭本测试模块。


[MITM]

hostname = %APPEND% un-acs.youku.com, pl-ali.youku.com
