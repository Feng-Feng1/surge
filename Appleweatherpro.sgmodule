#!name =  iRingo: 🌤 Apple 天气增强（Surge 优化版）
#!desc = 基于 NSRingo/WeatherKit v3.3.2；适配最新版 Surge 与 iOS 18+。解锁天气可用性，并增强天气、空气质量、未来一小时降水和天气预警。
#!openUrl = http://boxjs.com/#/app/iRingo.WeatherKit
#!author = VirgilClyne[https://github.com/VirgilClyne],WordlessEcho[https://github.com/WordlessEcho],001[https://github.com/001ProMax],hhh2210[https://github.com/hhh2210]
#!homepage = https://NSRingo.github.io/guide/Weather/weather-kit
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category =  iRingo
#!date = 2026-09-05
#!version = 3.3.2-opt.1
#!arguments = DataSets:"airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,weatherAlerts",Weather_Provider:"ColorfulClouds",WeatherAlerts_Provider:"QWeatherWeb",NextHour_Provider:"ColorfulClouds",AirQuality_Pollutants_Provider:"ColorfulClouds",AirQuality_Algorithm:"EU_EAQI",ColorfulClouds_Token:"",QWeather_Host:"devapi.qweather.com",QWeather_Token:"",WAQI_Token:"",Storage:"Argument",LogLevel:"WARN"
#!arguments-desc = 稳定默认值已预设，通常无需修改。空白令牌会回退到脚本内置默认值。\n\nDataSets：airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,weatherAlerts\nWeather_Provider：WeatherKit / ColorfulClouds / QWeather\nWeatherAlerts_Provider：WeatherKit / QWeatherWeb / QWeather / ColorfulClouds\nNextHour_Provider：WeatherKit / ColorfulClouds / QWeather\nAirQuality_Pollutants_Provider：ColorfulClouds / QWeather\nAirQuality_Algorithm：None / UBA / EU_EAQI / WAQI_InstantCast_US / WAQI_InstantCast_CN / WAQI_InstantCast_CN_25_DRAFT / CA_AQHI / HK_AQHI / AQHI_Multi_CN / AQHI_Multi_CN_HK / CN_DEATH_AQHI / CN_DEATH_HK_AQHI\nStorage：Argument / PersistentStore / database\nLogLevel：OFF / ERROR / WARN / INFO / DEBUG / ALL

# 上游版本固定为 v3.3.2，避免脚本和模块参数跨版本不兼容。
# 如同时安装过其他 WeatherKit、Apple 天气或同类 MITM 模块，请先停用，避免脚本抢占。

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
🌤 WeatherKit.api.v1.availability.response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/, requires-body=1, engine=webview, timeout=20, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/response.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather_Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts_Provider}}}"&NextHour.Provider="{{{NextHour_Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality_Pollutants_Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality_Algorithm}}}"&API.ColorfulClouds.Token="{{{ColorfulClouds_Token}}}"&API.QWeather.Host="{{{QWeather_Host}}}"&API.QWeather.Token="{{{QWeather_Token}}}"&API.WAQI.Token="{{{WAQI_Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🌤 WeatherKit.api.v1.airQualityScale.request = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/, engine=webview, timeout=20, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/request.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather_Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts_Provider}}}"&NextHour.Provider="{{{NextHour_Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality_Pollutants_Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality_Algorithm}}}"&API.ColorfulClouds.Token="{{{ColorfulClouds_Token}}}"&API.QWeather.Host="{{{QWeather_Host}}}"&API.QWeather.Token="{{{QWeather_Token}}}"&API.WAQI.Token="{{{WAQI_Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🌤 WeatherKit.api.v1.weatherAlerts.html.request = type=http-request, pattern="^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&|$)", engine=webview, timeout=20, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/request.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather_Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts_Provider}}}"&NextHour.Provider="{{{NextHour_Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality_Pollutants_Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality_Algorithm}}}"&API.ColorfulClouds.Token="{{{ColorfulClouds_Token}}}"&API.QWeather.Host="{{{QWeather_Host}}}"&API.QWeather.Token="{{{QWeather_Token}}}"&API.WAQI.Token="{{{WAQI_Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🌤 WeatherKit.api.v1.weatherAlerts.api.request = type=http-request, pattern="^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$)", engine=webview, timeout=20, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/request.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather_Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts_Provider}}}"&NextHour.Provider="{{{NextHour_Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality_Pollutants_Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality_Algorithm}}}"&API.ColorfulClouds.Token="{{{ColorfulClouds_Token}}}"&API.QWeather.Host="{{{QWeather_Host}}}"&API.QWeather.Token="{{{QWeather_Token}}}"&API.WAQI.Token="{{{WAQI_Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
🌤 WeatherKit.api.v2.weather.response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, timeout=20, script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/response.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Provider="{{{Weather_Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts_Provider}}}"&NextHour.Provider="{{{NextHour_Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality_Pollutants_Provider}}}"&AirQuality.Calculate.Algorithm="{{{AirQuality_Algorithm}}}"&API.ColorfulClouds.Token="{{{ColorfulClouds_Token}}}"&API.QWeather.Host="{{{QWeather_Host}}}"&API.QWeather.Token="{{{QWeather_Token}}}"&API.WAQI.Token="{{{WAQI_Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% weatherkit.apple.com
