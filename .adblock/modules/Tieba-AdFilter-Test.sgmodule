#!name=Baidu Tieba Ad Filter V2 Test
#!desc=百度贴吧独立测试分支：保留 V1 专用广告接口净化，新增清空个性推荐响应中已确认的 field #9 广告、adBid 广告竞价和贴吧商城推广；不修改帖子、头像及图片域名。
#!category=广告拦截
#!author=Night & ChatGPT
#!date=2026-09-05
#!version=2.0.0-test
#!system=ios

[Script]

贴吧-信息流广告净化 = type=http-response,pattern=^https:\/\/tiebac\.baidu\.com\/c\/f\/ad\/getFeedAd(?:\?|$),requires-body=true,max-size=-1,binary-body-mode=true,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/refs/heads/main/Tieba-AdFilter-Test.js?v=2,timeout=30

贴吧-开屏广告净化 = type=http-response,pattern=^https:\/\/tiebac\.baidu\.com\/c\/f\/ad\/getSplashAd(?:\?|$),requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/refs/heads/main/Tieba-AdFilter-Test.js?v=2,timeout=30

贴吧-个性推荐内嵌广告净化 = type=http-response,pattern=^https:\/\/tiebac\.baidu\.com\/c\/f\/excellent\/personalized(?:\?|$),requires-body=true,max-size=-1,binary-body-mode=true,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/refs/heads/main/Tieba-AdFilter-Test.js?v=2,timeout=30

贴吧-广告竞价净化 = type=http-response,pattern=^https:\/\/tiebac\.baidu\.com\/c\/b\/ad\/adBid(?:\?|$),requires-body=true,max-size=-1,binary-body-mode=true,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/refs/heads/main/Tieba-AdFilter-Test.js?v=2,timeout=30

贴吧-商城推广净化 = type=http-response,pattern=^https:\/\/tieba\.baidu\.com\/c\/f\/forum\/shopGoodsFeed(?:\?|$),requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/refs/heads/main/Tieba-AdFilter-Test.js?v=2,timeout=30

[MITM]

hostname = %APPEND% tiebac.baidu.com, tieba.baidu.com
