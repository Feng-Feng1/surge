#!name=腾讯视频去广告 RC7 · Loon
#!desc=沿用仓库腾讯视频 RC7 独立版：首页悬浮与开屏清理、播放广告请求和响应净化、定点广告素材拦截。
#!author=Night & ChatGPT；规则参考 blackmatrix7 等；Loon 配置：Feng-Feng1
#!system=iOS,iPadOS
#!loon_version=3.5.1(983)
#!date=2026-10-10
#!tag=去广告,视频
#!version=1.0.0

# 开启插件、脚本、Rewrite 与 MitM，安装并信任 Loon 的 MitM 证书。
# 首页/开屏使用 Uint8Array；getvinfo 使用字符串，不能把三项统一改成二进制。
# 原模块：TencentVideo-AdFilter.sgmodule @ 9dfe22c85592dd99d951a19d43e3b4a028a22cb0
# 直接加载仓库原脚本的固定版本，无需 Script Hub。

[Rule]
DOMAIN,p.l.qq.com,REJECT
DOMAIN,t.l.qq.com,REJECT
DOMAIN,us.l.qq.com,REJECT
DOMAIN,w.l.qq.com,REJECT
DOMAIN,vd6.l.qq.com,REJECT
DOMAIN,vi.l.qq.com,REJECT

[Rewrite]
# 对应 Surge Map Local：204 + 空正文，保留原匹配范围。
request if ${url} ~= /^http:\/\/pgdt\.gtimg\.cn\/141\/20204\/snscosdownload\/SZ\/reserved\/[0-9a-f]{48}(?:_dGltYWdl_[0-9]+)?(?:\?[^#]*)?$/ then reject(204)
request if ${url} ~= /^http:\/\/[^\/]+\/(?:[^?]*\/)?gzc_1000127_[^?\/]+\.f10215\.mp4(?:\?.*)?$/ then reject(204)
request if ${url} ~= /^http:\/\/[^\/]+\/(?:[^?]*\/)?gzc_1000173_[^?\/]+\.f(?:124105|206310[0-9]*)\.mp4(?:\?.*)?$/ then reject(204)
request if ${url} ~= /^http:\/\/vgdt\.gtimg\.cn\/[0-9]+\/[^?\/]+\.mp4(?:\?.*)?$/ then reject(204)

[Script]
response if ${url} ~= /^(?:https:\/\/i\.video\.qq\.com|https?:\/\/iacc\.qq\.com)\/$/ then script("https://raw.githubusercontent.com/Feng-Feng1/surge/9dfe22c85592dd99d951a19d43e3b4a028a22cb0/TencentVideo-PageClean-V1.txt?v=1.2.1-rc1") with requires_body=true, binary_body_mode=true, timeout=10, tag="腾讯视频首页悬浮与开屏清理"
request if ${url} ~= /^https:\/\/(?:s)?vv\.video\.qq\.com\/getvinfo(?:\?|$)/ then script("https://raw.githubusercontent.com/Feng-Feng1/surge/9dfe22c85592dd99d951a19d43e3b4a028a22cb0/TenVideo-MVL-AdFilter-Test.js?v=22") with requires_body=true, binary_body_mode=false, timeout=30, tag="腾讯视频播放广告请求净化"
response if ${url} ~= /^https:\/\/(?:s)?vv\.video\.qq\.com\/getvinfo(?:\?|$)/ then script("https://raw.githubusercontent.com/Feng-Feng1/surge/9dfe22c85592dd99d951a19d43e3b4a028a22cb0/TenVideo-MVL-AdFilter-Test.js?v=22") with requires_body=true, binary_body_mode=false, timeout=30, tag="腾讯视频播放广告响应净化"

[Mitm]
hostname = 112.60.20.144, 111.33.110.202, 111.33.110.163, 120.241.130.172, 112.60.23.213, 36.155.163.124, 36.155.228.69, 120.241.130.240, 120.232.131.191, 36.155.163.112, 36.155.205.219, i.video.qq.com, iacc.qq.com, svv.video.qq.com, vv.video.qq.com
